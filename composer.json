{
    "name": "macropay-solutions/php-framework",
    "description": "The Macropay-Solutions php framework template",
    "keywords": ["framework", "macropay-solutions"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.2",
        "macropay-solutions/php-kernel": "^1.0.0",
        "macropay-solutions/php-crufd-wizard": "^1.0.0",
        "macropay-solutions/php-crufd-wizard-decorator": "^1.0.0",
        "nikic/fast-route": "^1.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "mockery/mockery": "^1.6.12",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "macropay-solutions/php-kernel-dev": "^1.0.0",
        "macropay-solutions/php-crufd-wizard-generator": "^1.0.0"
    },
    "suggest": {
        "php": "8.2-8.5",
        "ext-zend-opcache": "*",
        "laravel/serializable-closure": "Require if you want to allow serrializable closures (^2.0.11)",
        "league/commonmark": "Required for Markdown mailables (^2.6)",
        "macropay-solutions/php-crufd-wizard-client": "^1.0.0",
        "symfony/mailer": "Required to send emails (^7.4)",
        "tijsverkoyen/css-to-inline-styles": "Required for HTML email styling (^2.2.5)"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "vendor/macropay-solutions/php-framework/src/helpers.php"
        ],
        "exclude-from-classmap": [
            "vendor/macropay-solutions/php-framework/illuminate/Broadcasting/",
            "vendor/macropay-solutions/php-framework/illuminate/Cookie/",
            "vendor/macropay-solutions/php-framework/illuminate/Encryption/",
            "vendor/macropay-solutions/php-framework/illuminate/Hashing/",
            "vendor/macropay-solutions/php-framework/illuminate/Mail/",
            "vendor/macropay-solutions/php-framework/illuminate/Notifications/",
            "vendor/macropay-solutions/php-framework/illuminate/Process/",
            "vendor/macropay-solutions/php-framework/illuminate/Redis/",
            "vendor/macropay-solutions/php-framework/illuminate/Routing/",
            "vendor/macropay-solutions/php-framework/illuminate/Session/",
            "vendor/macropay-solutions/php-framework/illuminate/View/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "[ \"$COMPOSER_DEV_MODE\" = \"1\" ] || php run commands:cache || echo run commands:cache failed",
            "[ \"$COMPOSER_DEV_MODE\" = \"1\" ] || php run route:cache || echo run route:cache failed",
            "[ \"$COMPOSER_DEV_MODE\" = \"1\" ] || php run config:cache || echo run config:cache failed",
            "[ \"$COMPOSER_DEV_MODE\" = \"1\" ] || php run autowiring:cache || echo run autowiring:cache failed",
            "[ \"$COMPOSER_DEV_MODE\" = \"1\" ] || php run event:cache || echo run event:cache failed",
            "[ \"$COMPOSER_DEV_MODE\" = \"1\" ] || php run view:cache || echo run view:cache failed",
            "[ \"$COMPOSER_DEV_MODE\" = \"1\" ] || php run merge-cached-files:cache || echo run merge-cached-files:cache failed"
        ],
        "post-root-package-install": [
            "[ \"$COMPOSER_DEV_MODE\" = \"0\" ] || php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php run key:generate --ansi || echo php run key:generate --ansi failed"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "RC",
    "prefer-stable": true
}
