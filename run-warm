#!/usr/bin/env php
<?php

if (!\extension_loaded('pcntl')) {
    \fwrite(STDERR, "The pcntl extension is required for run-warm.\n");
    exit(1);
}

if (!\extension_loaded('posix')) {
    \fwrite(STDERR, "The posix extension is required for run-warm.\n");
    exit(1);
}

// ── 0. SIGNAL HANDLING SETUP (Matching Worker.php logic) ──
$shouldQuit = false;
$paused = false;

\pcntl_async_signals(true);

\pcntl_signal(SIGQUIT, $sQ = static function () use (&$shouldQuit) {
    $shouldQuit = true;
});
\pcntl_signal(SIGTERM, $sQ);
\pcntl_signal(SIGINT, $sQ);
\pcntl_signal(SIGUSR2, static function () use (&$paused) {
    $paused = true;
});
\pcntl_signal(SIGCONT, static function () use (&$paused) {
    $paused = false;
});

// ── GUARDRAIL: Restrict this engine to queue workers only ──
if (!isset($_SERVER['argv'][1]) || $_SERVER['argv'][1] !== 'queue:work') {
    \fwrite(STDERR, "Fatal: run-warm is strictly restricted to the 'queue:work' command to prevent infinite loops.\n");
    exit(1);
}

/**
 * 1. PARENT INITIALIZATION
 * Executed once. Reads framework into RAM for Copy-on-Write inheritance.
 */
/** @var \App\Application $app */
$app = require __DIR__ . '/bootstrap/cli.php';

/**
 * 3. SOCKET SANITIZATION
 */
// Disconnect ALL active DB connections (mysql, pgsql, read/write replicas, tenants)
if ($app->resolved('db')) {
    $dbManager = $app->make('db');

    foreach (($dbManager->getConnections() ?? []) as $name => $connection) {
        /** @var \MacropaySolutions\Kernel\Database\Connection $connection */
        $dbManager->purge($name);
        \fwrite(STDERR, "Disconnected db connection {$name};\n");
    }
}

// Disconnect ALL active Redis connections (default, cache, publisher, etc.)
if ($app->resolved('redis')) {
    $redisManager = $app->make('redis');

    foreach (($redisManager->connections() ?? []) as $name => $connection) {
        /** @var \MacropaySolutions\Kernel\Redis\Connections\Connection $connection */
        $connection->disconnect();
        $redisManager->purge($name);
        \fwrite(STDERR, "Disconnected redis connection {$name};\n");
    }
}

/**
 * 2. THE PARENT DAEMON LOOP
 */
while (!$shouldQuit) {
    // Pause worker loop if SIGUSR2 was received
    if ($paused) {
        \sleep(1);

        continue;
    }

    /**
     * 4. THE FORK
     */
    $childPid = \pcntl_fork();

    /**
     * 5. FORK FAILURE (PARENT ONLY)
     */
    if ($childPid === -1) {
        \fwrite(STDERR, "Fatal: Unable to fork queue worker process.\n");
        exit(1);
    }

    /**
     * 6. CHILD EXECUTION (CHILD ONLY)
     */
    if ($childPid === 0) {
        require_once __DIR__ . '/worker/index.php';
        exit(0);
    }

    /**
     * 7. SYNCHRONOUS WAIT (PARENT ONLY)
     * Loop pcntl_waitpid until the child process is explicitly reaped ($res === $childPid).
     * Handles signal interruptions (EINTR) safely without inspecting partial/invalid status.
     */
    $status = 0;

    while (true) {
        $res = \pcntl_waitpid($childPid, $status);

        if ($res === $childPid) {
            break;
        }

        if ($res !== -1) {
            continue;
        }

        $error = \pcntl_get_last_error();

        if ($error === PCNTL_EINTR) {
            continue;
        }

        if ($error === PCNTL_ECHILD) {
            break;
        }

        \fwrite(
            STDERR,
            'Fatal: waitpid failed: ' . \pcntl_strerror($error) . "\n"
        );

        exit(1);
    }

    /**
     * 8. RESTART LOOP
     */
}
